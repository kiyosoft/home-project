#!/usr/bin/env python3
"""Mint a Home Assistant access token for the ingress sidebar session.

Never returns SUPERVISOR_TOKEN. The Supervisor websocket is used only inside
this process to create a long-lived Home Assistant token, which the SPA then
uses on Home Assistant's own websocket (same as a pasted token).
"""
from __future__ import annotations

import base64
import json
import os
import socket
import struct
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

HOST = "127.0.0.1"
PORT = 8098
TOKEN_PATH = Path(os.environ.get("ETHIO_TOKEN_PATH", "/data/ha_llat"))
SUPERVISOR_TOKEN = os.environ.get("SUPERVISOR_TOKEN", "")
WS_HOST = os.environ.get("ETHIO_HA_WS_HOST", "supervisor")
WS_PATH = os.environ.get("ETHIO_HA_WS_PATH", "/core/websocket")
VALIDATE_URL = os.environ.get("ETHIO_HA_VALIDATE_URL", "http://homeassistant:8123/api/")
CLIENT_NAME = "Ethio Home"
TOKEN_LIFESPAN_DAYS = 3650
INGRESS_USER_ID = "X-Remote-User-Id"
INGRESS_USER_NAME = "X-Remote-User-Name"
INGRESS_DISPLAY_NAME = "X-Remote-User-Display-Name"

_lock = threading.Lock()


class SessionError(Exception):
    pass


class WsStream:
    """Byte buffer so the handshake leftover is not dropped as the first frame."""

    def __init__(self, sock: socket.socket) -> None:
        self.sock = sock
        self.buf = bytearray()

    def read(self, size: int) -> bytes:
        while len(self.buf) < size:
            piece = self.sock.recv(max(size - len(self.buf), 4096))
            if not piece:
                raise SessionError("Home Assistant websocket closed")
            self.buf.extend(piece)
        data = bytes(self.buf[:size])
        del self.buf[:size]
        return data

    def handshake(self) -> None:
        key = base64.b64encode(os.urandom(16)).decode()
        request = (
            f"GET {WS_PATH} HTTP/1.1\r\n"
            f"Host: {WS_HOST}\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n"
            "\r\n"
        )
        self.sock.sendall(request.encode())
        response = b""
        while b"\r\n\r\n" not in response:
            piece = self.sock.recv(4096)
            if not piece:
                raise SessionError("Home Assistant websocket handshake failed")
            response += piece
        status = response.split(b"\r\n", 1)[0]
        if b"101" not in status:
            raise SessionError("Home Assistant websocket upgrade was refused")
        _header, leftover = response.split(b"\r\n\r\n", 1)
        self.buf.extend(leftover)


def _ws_send(sock: socket.socket, text: str) -> None:
    payload = text.encode()
    header = bytearray([0x81])
    length = len(payload)
    mask_bit = 0x80
    if length < 126:
        header.append(mask_bit | length)
    elif length < 65536:
        header.append(mask_bit | 126)
        header.extend(struct.pack(">H", length))
    else:
        header.append(mask_bit | 127)
        header.extend(struct.pack(">Q", length))
    mask = os.urandom(4)
    header.extend(mask)
    masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
    sock.sendall(header + masked)


def _ws_recv(stream: WsStream) -> str:
    while True:
        header = stream.read(2)
        opcode = header[0] & 0x0F
        length = header[1] & 0x7F
        masked = bool(header[1] & 0x80)
        if length == 126:
            length = struct.unpack(">H", stream.read(2))[0]
        elif length == 127:
            length = struct.unpack(">Q", stream.read(8))[0]
        mask = stream.read(4) if masked else b""
        payload = stream.read(length)
        if masked:
            payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        if opcode == 0x8:
            raise SessionError("Home Assistant websocket closed")
        if opcode == 0x9:
            stream.sock.sendall(b"\x8a" + bytes([len(payload)]) + payload)
            continue
        if opcode == 0xA:
            continue
        if opcode != 0x1:
            continue
        return payload.decode()


def _read_json(stream: WsStream) -> dict[str, Any]:
    message = json.loads(_ws_recv(stream))
    if not isinstance(message, dict):
        raise SessionError("Home Assistant sent a non-object websocket message")
    return message


def _exchange_for_token(send, recv_json) -> str:
    required = recv_json()
    if required.get("type") != "auth_required":
        raise SessionError("Home Assistant did not ask for websocket auth")

    send({"type": "auth", "access_token": SUPERVISOR_TOKEN})
    authed = recv_json()
    if authed.get("type") != "auth_ok":
        raise SessionError("Supervisor token was rejected by Home Assistant")

    send(
        {
            "id": 1,
            "type": "auth/long_lived_access_token",
            "client_name": CLIENT_NAME,
            "lifespan": TOKEN_LIFESPAN_DAYS,
        }
    )
    while True:
        result = recv_json()
        if result.get("type") == "result" and result.get("id") == 1:
            break

    if not result.get("success"):
        error = result.get("error") or {}
        message = error.get("message") if isinstance(error, dict) else None
        raise SessionError(message or "Could not mint a Home Assistant token")

    token = result.get("result")
    if not isinstance(token, str) or not token:
        raise SessionError("Home Assistant returned an empty access token")
    return token


def mint_with_client() -> str:
    import websocket

    ws = websocket.create_connection(f"ws://{WS_HOST}{WS_PATH}", timeout=10)
    try:

        def recv_json() -> dict[str, Any]:
            message = json.loads(ws.recv())
            if not isinstance(message, dict):
                raise SessionError("Home Assistant sent a non-object websocket message")
            return message

        return _exchange_for_token(
            lambda payload: ws.send(json.dumps(payload)),
            recv_json,
        )
    finally:
        ws.close()


def mint_with_stdlib() -> str:
    with socket.create_connection((WS_HOST, 80), timeout=10) as sock:
        sock.settimeout(10)
        stream = WsStream(sock)
        stream.handshake()
        return _exchange_for_token(
            lambda payload: _ws_send(sock, json.dumps(payload)),
            lambda: _read_json(stream),
        )


def mint_long_lived_token() -> str:
    if not SUPERVISOR_TOKEN:
        raise SessionError("SUPERVISOR_TOKEN is missing")
    try:
        return mint_with_client()
    except ImportError:
        return mint_with_stdlib()
    except SessionError:
        raise
    except Exception as error:
        print(f"[ethio-home-session] websocket-client failed, using stdlib: {error}")
        return mint_with_stdlib()


def token_is_valid(token: str) -> bool:
    request = Request(
        VALIDATE_URL,
        headers={"Authorization": f"Bearer {token}", "Accept": "application/json"},
        method="GET",
    )
    try:
        with urlopen(request, timeout=5) as response:
            return 200 <= response.status < 300
    except HTTPError as error:
        if error.code in {401, 403}:
            return False
        return True
    except URLError:
        return True


def load_stored_token() -> str | None:
    try:
        raw = TOKEN_PATH.read_text(encoding="utf-8").strip()
    except OSError:
        return None
    return raw or None


def save_stored_token(token: str) -> None:
    TOKEN_PATH.parent.mkdir(parents=True, exist_ok=True)
    TOKEN_PATH.write_text(token, encoding="utf-8")
    os.chmod(TOKEN_PATH, 0o600)


def get_access_token() -> str:
    with _lock:
        stored = load_stored_token()
        if stored and token_is_valid(stored):
            return stored
        token = mint_long_lived_token()
        save_stored_token(token)
        return token


def ingress_user(headers: Any) -> dict[str, str] | None:
    user_id = headers.get(INGRESS_USER_ID)
    if not user_id:
        return None
    return {
        "id": user_id,
        "username": headers.get(INGRESS_USER_NAME, ""),
        "name": headers.get(INGRESS_DISPLAY_NAME, ""),
    }


class Handler(BaseHTTPRequestHandler):
    def log_message(self, format: str, *args: object) -> None:
        print(f"[ethio-home-session] {self.address_string()} {format % args}")

    def _send(self, status: int, body: dict[str, object]) -> None:
        payload = json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def do_GET(self) -> None:
        path = self.path.split("?", 1)[0]
        if path == "/health":
            self._send(200, {"ok": True})
            return
        if path != "/session":
            self._send(404, {"ok": False, "error": "not-found"})
            return

        try:
            token = get_access_token()
        except SessionError as error:
            print(f"[ethio-home-session] {error}")
            self._send(
                503,
                {"ok": False, "error": "unavailable", "message": str(error)},
            )
            return
        except Exception as error:
            print(f"[ethio-home-session] {error}")
            self._send(
                503,
                {"ok": False, "error": "unavailable", "message": str(error)},
            )
            return

        self._send(200, {"ok": True, "token": token, "user": ingress_user(self.headers)})


def main() -> None:
    server = ThreadingHTTPServer((HOST, PORT), Handler)
    print(f"[ethio-home-session] listening on {HOST}:{PORT}")
    server.serve_forever()


if __name__ == "__main__":
    main()
