{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ethio/ha-sdk": ["../../packages/ha-sdk/src/index.ts"],
      "@ethio/plugin-sdk": ["../../packages/plugin-sdk/src/index.ts"],
      "@ethio/core": ["../../packages/core/src/index.ts"],
      "@ethio/teamtracker": ["../../packages/teamtracker/src/index.ts"],
      "@ethio/sinksar": ["../../packages/sinksar/src/index.ts"]
    },

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
