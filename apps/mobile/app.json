{
  "expo": {
    "name": "Ethio Home",
    "slug": "ethio-home-companion",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ethiohome",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.ethiohome.companion",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      },
      "infoPlist": {
        "NSBonjourServices": [
          "_home-assistant._tcp"
        ],
        "NSLocalNetworkUsageDescription": "Ethio Home looks for your Home Assistant on this network so you can connect without typing an address."
      }
    },
    "android": {
      "package": "app.ethiohome.companion",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f3f0ea",
          "dark": {
            "backgroundColor": "#0c1218"
          }
        }
      ],
      "expo-video",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ethio Home reads the name of the Wi-Fi network you are on to tell whether it should use your home address or your remote one. Your location is never stored or sent anywhere.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Ethio Home uses the microphone so you can talk to your home with Assist."
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#0f6b5c",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
